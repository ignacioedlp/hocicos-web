---
import '../styles/motion.css';
const chapters = [
  { title: 'Una foto. Un primer paso.', text: 'Luna se perdió. Su familia publica una foto y la zona donde la vio por última vez.', image: '/images/step-report.jpg', alt: 'Foto de un perro en un teléfono', label: 'Publicar la alerta', status: 'Buscando a Luna' },
  { title: 'Alguien cerca puede ayudar.', text: 'Una persona del barrio ve la alerta. Comparte la información y avisa que vio una mascota parecida.', image: '/images/step-map.jpg', alt: 'Mapa con ubicaciones en un teléfono', label: 'Compartir en el barrio', status: 'Una nueva pista' },
  { title: 'Y un día, vuelve a casa.', text: 'Una pista acerca a su familia. Ese pequeño gesto puede convertirse en un gran reencuentro.', image: '/images/reunion-v2.jpg', alt: 'Una persona abraza a un perro', label: 'Volver a encontrarse', status: 'De nuevo juntos' },
];
const faqs = [
 ['¿Cuándo voy a poder usar Hocicos?', 'Estamos preparando el lanzamiento. Podés pedirnos un aviso por correo y te contactaremos cuando haya novedades.'],
 ['¿Puedo ayudar si no tengo una mascota?', 'Sí. Mirar una alerta, compartirla o aportar una pista también es una forma de ayudar.'],
 ['¿Hocicos va a ser gratis?', 'Las funciones necesarias para buscar y encontrar mascotas serán gratuitas.'],
 ['¿Cómo van a cuidar mis datos?', 'La propuesta de Hocicos es mostrar ubicaciones aproximadas y mantener los datos de contacto fuera de las publicaciones públicas. Antes del lanzamiento publicaremos los términos y la política de privacidad completos.'],
];
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#fff8f1"/>
  <meta name="description" content="Una red de personas que cuida. Conocé Hocicos y pedí un aviso cuando la app esté disponible."/>
  <title>Hocicos — Nadie debería buscar solo</title>
  <link rel="icon" href="/favicon.svg"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900;1000&family=Caveat:wght@500;600;700&display=swap" rel="stylesheet"/>
</head>
<body class="v2-motion">
<a class="skip" href="#contenido">Ir al contenido</a>
<header class="site-header">
  <a class="brand" href="#inicio" aria-label="Hocicos, inicio"><img src="/brand-mark.svg" alt="" width="48" height="48"/>Hocicos</a>
  <nav aria-label="Navegación principal"><a href="#historia">Cómo ayudamos</a><a href="#nosotros">Por qué Hocicos</a><a href="#preguntas">Preguntas</a></nav>
  <a class="header-cta" href="#sumate">Quiero ser parte <span aria-hidden="true">↗</span></a>
</header>
<main id="contenido">
  <section class="hero" id="inicio">
    <div class="hero-content">
      <span class="launch-label"><span></span> Una comunidad en camino</span>
      <h1>Que perderse<br/>no sea<br/><em>desaparecer.</em></h1>
      <p>Una foto. Una pista. Alguien que mira.<br/>Cuando un barrio se mueve, volver a casa está un poquito más cerca.</p>
      <div class="hero-actions"><a class="button" href="#sumate">Avisame del lanzamiento <span aria-hidden="true">→</span></a><a class="text-link" href="#historia">Así podemos ayudar</a></div>
      <small>Estamos preparando Hocicos para iOS y Android.</small>
    </div>
    <div class="hero-picture"><img src="/images/hero-dog-v2.jpg" alt="Un perro descansa en el sillón de su casa" fetchpriority="high" width="1536" height="1024"/><span class="hand-note">Su lugar favorito.<br/>Cerca de vos.</span><div class="photo-caption"><img src="/icon-transparent.svg" alt=""/><span>Pequeños gestos.<br/><strong>Grandes reencuentros.</strong></span></div></div>
  </section>
  <div class="belief"><span>Para quienes buscan.</span><img src="/brand-mark.svg" alt=""/><span>Para quienes encuentran.</span><img src="/brand-mark.svg" alt=""/><span>Para quienes dan una mano.</span></div>
  <section id="historia" class="journey section-wrap reveal">
    <div class="section-heading"><div><h2>Un barrio.<br/><em>Muchas formas de ayudar.</em></h2><p>Así imaginamos el camino de una alerta a un reencuentro.</p></div><span class="hand-note">Vos podés ser<br/>parte de esta historia.</span></div>
    <p class="example-label">La historia de Luna · Ejemplo ilustrativo de cómo funcionará Hocicos</p>
    <div class="story-experience"><div class="story-tabs" role="tablist" aria-label="La historia de Luna">{chapters.map((chapter, i) => <button id={`tab-${i}`} role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`chapter-${i}`} tabindex={i === 0 ? 0 : -1}><span class="tab-number">{i + 1}</span>{chapter.label}</button>)}</div>
    <div class="chapters">{chapters.map((chapter, i) => <div id={`chapter-${i}`} class="chapter" role="tabpanel" aria-labelledby={`tab-${i}`} tabindex="0" hidden={i !== 0}><div class="chapter-image"><img src={chapter.image} alt={chapter.alt} width="900" height="650" loading="lazy"/><span class="chapter-status"><span></span>{chapter.status}</span></div><div class="chapter-copy"><span class="chapter-count">PASO {i + 1} DE 3</span><h3>{chapter.title}</h3><p>{chapter.text}</p><p class="chapter-aside">{i === 0 ? 'No hace falta tener todas las respuestas para empezar.' : i === 1 ? 'A veces, ayudar empieza con prestar atención.' : 'Eso es lo que queremos hacer posible.'}</p>{i < 2 ? <button class="next-chapter" data-next={i + 1}>Seguir la historia <span aria-hidden="true">→</span></button> : <a class="text-link" href="#sumate">Quiero ser parte de Hocicos →</a>}</div></div>)}</div></div>
    <p class="story-announcement" aria-live="polite" aria-atomic="true"></p>
  </section>
  <section id="nosotros" class="mission reveal"><div class="mission-photo"><img src="/images/community-v2.jpg" alt="Una persona pasea con su perro" width="900" height="900" loading="lazy"/><span class="hand-note">El cuidado empieza<br/>mucho antes de perderse.</span></div><div class="mission-copy"><img class="mission-mark" src="/brand-mark.svg" alt="" width="60" height="60"/><h2>Nadie debería<br/><em>buscar solo.</em></h2><p>Hocicos nace de una idea simple: conectar a quienes necesitan ayuda con quienes pueden dar una mano.</p><p>Queremos que la tecnología acerque a las personas. Que una alerta encuentre ojos atentos. Y que cada mascota tenga más oportunidades de volver a casa.</p><a class="text-link" href="mailto:hola@hocicos.app?subject=Quiero%20conocer%20m%C3%A1s%20sobre%20Hocicos">Hablemos. Del otro lado hay personas. ↗</a></div></section>
  <section class="care section-wrap reveal" id="cuidado"><div><h2>Cuidar también es<br/><em>cuidarte a vos.</em></h2><p>Estamos diseñando Hocicos para que puedas ayudar con tranquilidad.</p><dl><div><dt>Tu contacto, en privado.</dt><dd>Los datos de contacto no se mostrarán en las alertas públicas.</dd></div><div><dt>Cerca, sin exponerte.</dt><dd>Las publicaciones mostrarán una ubicación aproximada.</dd></div><div><dt>Ayudar, sin suscripciones.</dt><dd>Buscar y encontrar mascotas será gratuito.</dd></div></dl><a class="text-link" href="#preguntas">Tengo algunas preguntas →</a></div><div class="cat-photo"><img src="/images/cat-v2.jpg" alt="Un gato curioso mira hacia la cámara" width="900" height="900" loading="lazy"/><span class="hand-note">Para todos los hocicos.<br/>Sí, el suyo también.</span></div></section>
  <section id="preguntas" class="faq section-wrap reveal"><div><h2>Antes de sumarte.</h2><p>Algunas cosas que quizás quieras saber.</p></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
  <section id="sumate" class="join reveal"><img src="/icon-transparent.svg" alt="" width="70" height="70"/><h2>Tu barrio también<br/>puede ser <em>un refugio.</em></h2><p>Estamos preparando una comunidad que cuida.<br/>Pedí un aviso para enterarte del lanzamiento.</p><a class="button" href="mailto:hola@hocicos.app?subject=Avisame%20cuando%20lance%20Hocicos&body=Hola%2C%20quiero%20recibir%20un%20aviso%20cuando%20Hocicos%20est%C3%A9%20disponible.%20%C2%A1Gracias%21">Pedir aviso por email <span aria-hidden="true">↗</span></a><small>Se abrirá tu aplicación de correo con el mensaje preparado.<br/>Enviá el correo para pedirnos el aviso.</small><span class="hand-note">Las buenas noticias<br/>se comparten.</span></section>
</main>
<footer><a class="brand" href="#inicio"><img src="/brand-mark.svg" alt="" width="32" height="32"/>Hocicos</a><p>Pequeños gestos, grandes reencuentros.<br/><small>© {new Date().getFullYear()} Hocicos</small></p><div><a href="mailto:hola@hocicos.app">Contacto</a><a href="#informacion">Información del lanzamiento</a></div></footer>
<section class="launch-info" id="informacion"><h2>Una comunidad en construcción.</h2><p>La app todavía no está disponible. Publicaremos los términos de uso y la política de privacidad antes del lanzamiento. Si tenés una consulta sobre tus datos o sobre el proyecto, escribinos a <a href="mailto:hola@hocicos.app">hola@hocicos.app</a>.</p></section>
<script>import '../scripts/v2-motion';</script>
<style is:global>
:root{font-family:Nunito,sans-serif;background:#fffaf6;color:#2c231e;--coral:#bc492e;--peach:#f6ddd0;scroll-behavior:smooth}*{box-sizing:border-box}body{margin:0}h1,h2,h3,p{margin:0}h1,h2,h3{letter-spacing:-.035em;text-wrap:balance}h1,h2{font-weight:1000;line-height:1.04}h2{font-size:clamp(2.6rem,4.1vw,4.2rem)}em{font-style:normal;color:var(--coral)}p{line-height:1.6}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}a,button,summary{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible,summary:focus-visible,[role=tabpanel]:focus-visible{outline:3px solid var(--coral);outline-offset:5px}::selection{background:#f6c9b6;color:#2c231e}.skip{position:absolute;top:0;left:20px;translate:0 -120%;z-index:20;background:#fff;padding:12px}.skip:focus{translate:0 0}.site-header{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:22px 5.7%;background:#fffaf6}.brand{display:flex;align-items:center;font-weight:1000;font-size:2rem;letter-spacing:-.035em;gap:5px}.brand img{object-fit:contain}.site-header nav{display:flex;gap:30px;font-size:.9rem;font-weight:800}.header-cta,.button{display:inline-flex;gap:22px;align-items:center;justify-content:center;background:var(--coral);color:#fff;padding:15px 22px;border-radius:12px;font-weight:900;line-height:1.2;border:0}.header-cta{font-size:.9rem}.button:hover,.header-cta:hover{transform:translateY(-3px);box-shadow:0 8px 20px #63331f25}.hero{display:grid;grid-template-columns:1fr 1fr;min-height:640px}.hero-content{padding:50px 6% 65px 11.4%;align-self:center}.launch-label{display:inline-flex;align-items:center;gap:9px;color:#6a5145;font-size:.8rem;font-weight:800;margin-bottom:25px}.launch-label>span{width:7px;height:7px;border-radius:50%;background:var(--coral)}h1{font-size:clamp(3.7rem,5.8vw,5.9rem)}.hero-content>p{font-size:1.18rem;margin:25px 0;max-width:42ch}.hero-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap}.text-link{font-weight:900;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px;color:var(--coral);font-size:.95rem}.hero-content>small{display:block;font-size:.78rem;color:#745b4c;margin-top:17px}.hero-picture{position:relative;overflow:hidden;border-radius:150px 0 0 0;min-height:560px}.hero-picture>img{width:100%;height:100%;object-fit:cover;object-position:67% center;position:absolute;inset:0}.hand-note{font-family:Caveat,cursive;font-size:1.7rem;line-height:1.1;display:block;transform:rotate(-7deg)}.hero-picture>.hand-note{position:absolute;top:35px;right:30px;background:#fff7ef;padding:18px 22px;border-radius:8px;color:#3f3027}.photo-caption{position:absolute;bottom:30px;left:30px;background:#fffaf6;padding:15px 20px;display:flex;gap:15px;align-items:center;border-radius:12px;font-size:.85rem;box-shadow:0 8px 28px #2c231e20}.photo-caption img{width:38px;filter:brightness(0) saturate(100%);opacity:.75}.belief{padding:30px 5.7%;display:flex;justify-content:space-between;align-items:center;gap:20px;background:#f6e6db;font-weight:800;color:#604536}.belief img{width:26px;height:26px;opacity:.7}.section-wrap{padding:100px 5.7%}.section-heading{display:flex;justify-content:space-between;align-items:center;gap:30px}.section-heading p{margin-top:20px;font-size:1.1rem}.section-heading>.hand-note{margin-right:40px;color:#785340}.example-label{font-size:.8rem;color:#745b4c;margin-top:40px}.story-tabs{display:grid;grid-template-columns:repeat(3,1fr);margin:16px 0 25px;border-bottom:1px solid #d7bdae}.story-tabs button{display:flex;align-items:center;gap:12px;text-align:left;padding:18px 12px;border:0;border-bottom:3px solid transparent;background:transparent;color:#755b4c;font-weight:900}.story-tabs button[aria-selected=true]{border-bottom-color:var(--coral);color:var(--coral)}.tab-number{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;background:#f5e3d8;flex:none;font-size:.85rem}.story-tabs button[aria-selected=true] .tab-number{background:var(--coral);color:white}.chapter{display:grid;grid-template-columns:1.05fr 1fr;gap:7%;align-items:center}.chapter[hidden]{display:none}.chapter-image{height:400px;border-radius:65px 65px 16px 16px;overflow:hidden;position:relative}.chapter-image>img{height:100%;width:100%;object-fit:cover}.chapter-status{position:absolute;bottom:22px;left:22px;background:#fffaf6;border-radius:12px;padding:12px 18px;font-weight:800;font-size:.85rem;display:flex;align-items:center;gap:9px;box-shadow:0 6px 20px #2c231e20}.chapter-status>span{height:8px;width:8px;background:var(--coral);border-radius:50%}.chapter-count{font-size:.72rem;font-weight:800;color:#735243}.chapter-copy h3{font-size:clamp(2rem,3.2vw,3.3rem);line-height:1.1;font-weight:1000;margin-top:12px}.chapter-copy>p{font-size:1.12rem;max-width:43ch;margin-top:20px}.chapter-copy .chapter-aside{font-family:Caveat,cursive;font-size:1.6rem;color:#80523d;line-height:1.15;margin:22px 0}.next-chapter{border:0;background:none;padding:10px 0;color:var(--coral);font-weight:900;display:flex;gap:24px}.mission{display:grid;grid-template-columns:1fr 1fr;background:#f5e5d9}.mission-photo{min-height:570px;position:relative;overflow:hidden}.mission-photo>img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}.mission-photo>.hand-note{position:absolute;bottom:32px;left:32px;background:#fffaf6;padding:18px;border-radius:8px}.mission-copy{padding:65px 12%}.mission-mark{margin-bottom:18px}.mission-copy p{font-size:1.1rem;margin:24px 0;max-width:47ch}.care{display:grid;grid-template-columns:1.15fr 1fr;gap:9%;align-items:center}.care p{margin-top:20px;font-size:1.1rem;max-width:42ch}.care dl{margin:30px 0}.care dl>div{padding:18px 0;border-bottom:1px solid #e4d1c3}.care dt{font-size:1.15rem;font-weight:900}.care dd{margin:5px 0 0;line-height:1.5;color:#725344}.cat-photo{height:530px;overflow:hidden;border-radius:130px 130px 18px 18px;position:relative}.cat-photo img{width:100%;height:100%;object-fit:cover;object-position:66% center}.cat-photo>.hand-note{position:absolute;bottom:25px;left:20px;background:#fff8ef;padding:16px 22px;border-radius:8px}.faq{background:#fff3e9;display:grid;grid-template-columns:1fr 1.2fr;gap:8%;align-items:start}.faq>div>p{margin-top:18px;color:#735545}.faq details{border-bottom:1px solid #dec6b5;padding:23px 0}.faq details:first-child{border-top:1px solid #dec6b5}.faq summary{font-size:1.05rem;font-weight:900;line-height:1.4}.faq details p{padding:15px 0 0;max-width:65ch;font-size:.98rem;color:#644a3c}.join{padding:80px 5.7%;text-align:center;background:#302820;color:#fff7ed;position:relative;overflow:hidden}.join>img{margin-bottom:18px}.join em{color:#f3a98b}.join p{margin:23px 0;font-size:1.12rem}.join .button{background:#f3a98b;color:#382317}.join small{display:block;margin-top:18px;line-height:1.5;color:#e3c8b7;font-size:.78rem}.join .hand-note{position:absolute;right:6%;bottom:70px;color:#f3c9b5}footer{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:35px 5.7%}footer .brand{font-size:1.55rem}footer p{font-size:.8rem;color:#745344}footer div{display:flex;gap:25px;font-size:.8rem;font-weight:800}.launch-info{border-top:1px solid #ead8cb;padding:25px 5.7% 35px;color:#755544}.launch-info h2{font-size:1rem;letter-spacing:0}.launch-info p{max-width:90ch;font-size:.8rem;margin-top:8px}.launch-info a{text-decoration:underline;text-underline-offset:3px}body{scrollbar-color:#c88c72 #fffaf6}.reveal{opacity:1}
@media(max-width:1000px){.site-header nav{gap:16px}.hero-content{padding-left:8%;padding-right:5%}h1{font-size:4rem}.hero-actions{gap:16px}.hero-picture{border-radius:90px 0 0 0}.section-wrap{padding:75px 5%}.mission-copy{padding:50px 9%}.join .hand-note{display:none}.care{gap:5%}}
@media(max-width:700px){.site-header{padding:18px 5%;gap:12px}.brand{font-size:1.7rem}.brand img{width:38px;height:38px}.site-header nav{display:none}.header-cta{font-size:.75rem;padding:12px;gap:10px}.hero{grid-template-columns:1fr}.hero-content{padding:35px 5% 40px}.hero h1{font-size:clamp(3.15rem,11.6vw,4.7rem)}.hero-content>p{font-size:1.05rem}.hero-picture{min-height:365px;border-radius:70px 70px 0 0;margin:0 5%}.hero-picture>img{object-position:65% center}.hero-picture>.hand-note{font-size:1.35rem;top:20px;right:15px;padding:12px}.photo-caption{bottom:20px;left:15px;font-size:.75rem;padding:12px}.belief{padding:23px 5%;flex-wrap:wrap;justify-content:center;gap:10px 16px;font-size:.78rem}.belief img{width:19px;height:19px}.belief img:last-of-type{display:none}.section-wrap{padding:60px 5%}h2{font-size:2.65rem}.section-heading>.hand-note{display:none}.section-heading p{font-size:1rem}.example-label{margin-top:27px;font-size:.73rem;max-width:40ch}.story-tabs{margin-top:12px;gap:5px}.story-tabs button{font-size:.72rem;padding:14px 3px;gap:7px;align-items:flex-start;flex-direction:column}.tab-number{width:26px;height:26px}.chapter{grid-template-columns:1fr;gap:26px}.chapter-image{height:290px;border-radius:45px 45px 14px 14px}.chapter-copy h3{font-size:2.2rem}.chapter-copy p{font-size:1rem}.mission{grid-template-columns:1fr}.mission-photo{min-height:350px}.mission-copy{padding:45px 5% 55px}.mission-copy p{font-size:1rem}.care{grid-template-columns:1fr;gap:35px}.cat-photo{height:340px;border-radius:85px 85px 15px 15px}.faq{grid-template-columns:1fr;gap:30px}.faq summary{font-size:1rem}.faq details p{font-size:.9rem}.join{padding:60px 5%}.join h2{font-size:2.6rem}.join p{font-size:1rem}footer{flex-wrap:wrap;padding:30px 5%;gap:20px}footer div{flex-wrap:wrap;gap:18px;width:100%}.launch-info{padding-left:5%;padding-right:5%}}
</style>
<style is:global>
@import '../styles/v2-motion.css';
</style>
</body>
</html>
